{
  "expo": {
    "name": "Geek",
    "slug": "geek",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "platforms": ["ios", "android"],
    "scheme": "geek",
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Geek utilise vos photos pour illustrer vos copies physiques.",
          "cameraPermission": "Geek utilise l’appareil photo pour photographier vos copies physiques.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
