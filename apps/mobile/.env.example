# Public Supabase configuration for the Expo app.
#
# Copy this file to .env.local and fill in the values printed by `pnpm db:status`
# (API URL and anon key). Both values are public by design and ship inside the
# app bundle; access control comes from Auth and row-level security.
#
# Never put SERVICE_ROLE_KEY or database credentials in this file.

EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
