# Public Supabase configuration for the web app.
#
# Copy this file to .env.local and fill in the values printed by `pnpm db:status`
# (API URL and anon key). Both values are public by design and ship in the
# browser bundle; access control comes from Auth and row-level security.
#
# Never put SERVICE_ROLE_KEY or database credentials in this file.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Origin the app's own Auth emails link back to. Read on the server only, and
# never taken from the request's Host header, which the requester controls.
# Must be a bare origin: scheme and host, no trailing path. Optional locally,
# where it defaults to the value below; required in hosted environments, and it
# also has to be allowed in supabase/config.toml.
APP_ORIGIN=http://127.0.0.1:3000
