{
  "name": "geek",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=25.0.0",
    "pnpm": ">=11.20.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @geek/mobile --filter @geek/web --filter @geek/admin run dev",
    "dev:mobile": "pnpm --filter @geek/mobile run dev",
    "dev:web": "pnpm --filter @geek/web run dev",
    "dev:admin": "pnpm --filter @geek/admin run dev",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types --local --lang typescript --schema public > packages/supabase/src/database.types.ts && prettier --write --log-level warn packages/supabase/src/database.types.ts",
    "db:smoke": "node scripts/supabase-smoke.mjs",
    "db:smoke:auth": "node --experimental-strip-types scripts/supabase-auth-smoke.mjs",
    "db:smoke:data": "node --experimental-strip-types scripts/supabase-data-smoke.mjs",
    "db:smoke:wishlist": "node --experimental-strip-types scripts/supabase-wishlist-intent-smoke.mjs",
    "db:smoke:follow": "node --experimental-strip-types scripts/supabase-follow-smoke.mjs",
    "db:smoke:match": "node --experimental-strip-types scripts/supabase-match-contracts-smoke.mjs",
    "db:smoke:albums": "node --experimental-strip-types scripts/supabase-albums-smoke.mjs",
    "db:smoke:catalog-media": "node --experimental-strip-types scripts/supabase-catalog-media-smoke.mjs",
    "db:smoke:copy-photos": "node --experimental-strip-types scripts/supabase-copy-photos-smoke.mjs",
    "db:smoke:market-opportunities": "node --experimental-strip-types scripts/supabase-market-opportunities-smoke.mjs",
    "db:smoke:create-listing": "node --experimental-strip-types scripts/supabase-create-listing-smoke.mjs",
    "catalog:import:libretro": "pnpm --filter @geek/catalog-import run import:libretro",
    "catalog:import:mobygames": "pnpm --filter @geek/catalog-import run import:mobygames",
    "catalog:import:smoke": "node --experimental-strip-types scripts/supabase-catalog-import-smoke.mjs",
    "catalog:import:mobygames:smoke": "node --experimental-strip-types scripts/supabase-mobygames-import-smoke.mjs",
    "catalog:import:mobygames:atomicity-smoke": "node --experimental-strip-types scripts/supabase-mobygames-atomicity-smoke.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint eslint.config.mjs scripts && pnpm --recursive --if-present run lint",
    "typecheck": "pnpm --recursive --if-present run typecheck"
  },
  "devDependencies": {
    "@geek/config": "workspace:*",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.2",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "supabase": "2.112.0",
    "typescript": "6.0.3"
  },
  "prettier": "@geek/config/prettier"
}
